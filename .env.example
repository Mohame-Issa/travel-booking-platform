# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit it or paste its values into an AI tool.

# Shared MongoDB Atlas connection string (ask the team leader privately).
MONGODB_URI=

# Secret for signing access tokens: at least 32 random characters.
# Generate your own with:  openssl rand -hex 32
JWT_SECRET=

# Optional. Port the API listens on (default 3000).
PORT=

# Optional. Cookies are Secure by default. Set to false only if your browser
# refuses Secure cookies on http://localhost (e.g. Safari).
COOKIE_SECURE=

# Optional. lax (default), strict or none.
COOKIE_SAMESITE=

# Optional. Frontend origin allowed to send cookies, e.g. http://localhost:3001 (Milestone 2).
FRONTEND_URL=

# Stripe TEST mode (PAY-01). Dashboard -> Developers -> API keys. Must start with sk_test_.
# Optional: without it the app starts but the payment endpoints answer 503.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...). Locally, copy it from the output of:
#   stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Optional (GEN-08). Folder for uploaded images, relative to where the server starts
# (npm scripts run in backend/, so the default "uploads" means backend/uploads).
UPLOAD_DIR=

# Seed only. Set locally; existing accounts/passwords are never reset on reruns.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Required only for `npm run seed -- --apply --with-demo`.
SEED_AIRLINE_MODERATOR_EMAIL=
SEED_AIRLINE_MODERATOR_PASSWORD=
SEED_HOTEL_MODERATOR_EMAIL=
SEED_HOTEL_MODERATOR_PASSWORD=

# Optional. FXRatesAPI key for itinerary currency conversion (ITN-18).
# https://fxratesapi.com - the free tier also works without a key.
FXRATES_API_KEY=

# Optional (ACC-02 / ACC-07). SMTP of a TEST inbox such as Mailtrap. Leave empty to
# use a free Ethereal test inbox: each email is then logged with a link to read it.
# To send to real inboxes for a demo, use e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=your Gmail address, SMTP_PASS=a Google App Password (never your real password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional. Public address of this API used in the emailed links (default http://localhost:PORT).
BACKEND_URL=
